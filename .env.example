APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
QUEUE_NAME=default
QUEUE_RETRY_AFTER=1800
QUEUE_FAILED_DRIVER=database-uuids
EMPLOYEE_MEDIA_ZIP_CHUNK_SIZE=5
EMPLOYEE_IMPORT_DISK=employee_imports
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

RECRUITMENT_API_URL=https://recruitment.vdnisite.com
RECRUITMENT_API_TOKEN=
RECRUITMENT_API_TIMEOUT=10
RECRUITMENT_DOCUMENT_CACHE_TTL=3

PRESENSI_FACE_VERIFICATION_URL=
PRESENSI_FACE_VERIFICATION_TOKEN=
PRESENSI_FACE_VERIFICATION_TIMEOUT=8
PRESENSI_FACE_VERIFICATION_CONNECT_TIMEOUT=2
PRESENSI_FACE_MIN_CONFIDENCE=0.78
PRESENSI_LIVENESS_MIN_SCORE=0.78
PRESENSI_REQUIRE_ACTIVE_LIVENESS=true
PRESENSI_FACE_FAIL_CLOSED=false
